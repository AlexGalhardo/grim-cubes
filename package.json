{
	"name": "grim-cubes",
	"version": "0.5.0",
	"description": "Grim Cubes, a grimdark voxel wave-survival roguelite",
	"author": "Alex Galhardo",
	"main": "apps/electron/dist/main.cjs",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.4",
		"node": ">=22.12"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "vite --config apps/web/vite.config.ts",
		"build": "bun run data:check && bun run assets:build && vite build --config apps/web/vite.config.ts --mode web-demo",
		"build:electron": "bun tools/build-electron/index.ts",
		"build:android": "bun tools/build-android/index.ts",
		"typecheck": "bun check -b",
		"lint": "biome ci .",
		"lint:md": "markdownlint-cli2 \"**/*.md\"",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:smoke": "bun tools/smoke/run.ts",
		"test:perf": "playwright test --config tools/perf/playwright.config.ts",
		"sim": "bun tools/sim/index.ts",
		"assets:gen": "bun tools/assets-gen/index.ts",
		"assets:build": "bun tools/assets-build/index.ts",
		"audio:generate": "bun tools/audio-generate/index.ts",
		"data:check": "bun tools/data-check/index.ts",
		"release": "bun tools/release/index.ts"
	},
	"dependencies": {
		"@babylonjs/core": "9.33.1",
		"@babylonjs/loaders": "9.33.1",
		"bitecs": "0.4.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"simplex-noise": "4.0.3"
	},
	"devDependencies": {
		"@babylonjs/inspector": "9.33.1",
		"@biomejs/biome": "2.6.4",
		"@gltf-transform/core": "4.5.1",
		"@playwright/test": "1.64.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/react": "16.3.3",
		"@types/bun": "1.4.4",
		"@types/pngjs": "6.0.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/coverage-istanbul": "5.0.5",
		"axe-core": "4.14.0",
		"electron": "45.2.1",
		"electron-builder": "26.18.0",
		"fake-indexeddb": "6.2.7",
		"jsdom": "30.1.3",
		"lefthook": "2.2.2",
		"markdownlint-cli2": "0.24.0",
		"pngjs": "7.0.0",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
