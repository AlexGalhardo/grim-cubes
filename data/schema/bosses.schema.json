{
	"type": "array",
	"minItems": 1,
	"items": {
		"type": "object",
		"required": ["id", "name", "round", "hpBaseRound10", "archetype", "delivery", "patterns"],
		"additionalProperties": false,
		"properties": {
			"id": {
				"$ref": "common.schema.json#/$defs/id"
			},
			"name": {
				"$ref": "common.schema.json#/$defs/name"
			},
			"round": {
				"type": "integer",
				"minimum": 1
			},
			"hpBaseRound10": {
				"type": "number",
				"minimum": 1
			},
			"radius": { "type": "number", "minimum": 0.1 },
			"speed": { "type": "number", "minimum": 0 },
			"patternCooldownSeconds": { "type": "number", "minimum": 0 },
			"archetype": {
				"$ref": "common.schema.json#/$defs/id"
			},
			"delivery": {
				"enum": ["PROTOTYPE", "ALPHA", "BETA"]
			},
			"patterns": {
				"type": "array",
				"minItems": 1,
				"items": {
					"$ref": "common.schema.json#/$defs/effect"
				}
			}
		}
	}
}
