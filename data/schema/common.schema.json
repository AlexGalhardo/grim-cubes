{
	"$id": "common.schema.json",
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*$"
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"tier": {
			"type": "integer",
			"minimum": 1,
			"maximum": 5
		},
		"stat": {
			"enum": [
				"max_hp",
				"hp_regen",
				"life_steal",
				"damage",
				"attack_speed",
				"crit_chance",
				"range",
				"armor",
				"dodge",
				"speed",
				"luck",
				"harvest",
				"pickup_range",
				"xp_gain",
				"shop_price",
				"explosion_size",
				"knockback",
				"enemy_speed",
				"boss_damage",
				"free_rerolls"
			]
		},
		"modifier": {
			"type": "object",
			"required": ["stat", "op", "value"],
			"additionalProperties": false,
			"properties": {
				"stat": {
					"$ref": "common.schema.json#/$defs/stat"
				},
				"op": {
					"enum": ["add", "mul"]
				},
				"value": {
					"type": "number"
				}
			}
		},
		"modifiers": {
			"type": "array",
			"items": {
				"$ref": "common.schema.json#/$defs/modifier"
			}
		},
		"effect": {
			"type": "object",
			"required": ["id"],
			"additionalProperties": false,
			"properties": {
				"id": {
					"$ref": "common.schema.json#/$defs/effectId"
				},
				"params": {
					"type": "object"
				}
			}
		},
		"effects": {
			"type": "array",
			"items": {
				"$ref": "common.schema.json#/$defs/effect"
			}
		},
		"effectId": {
			"enum": [
				"auto_bolt",
				"bleed_on_crit",
				"bonus_damage_vs_elites",
				"card_rerolls",
				"chain_lightning",
				"close_range_damage_mult",
				"contact_damage",
				"crit_chance_bonus",
				"crit_mult_set",
				"damage_per_missing_hp",
				"dash_charges",
				"dash_cooldown_reduction",
				"dash_unlock",
				"double_fragment_chance",
				"drop_mine",
				"end_of_round_fragment_bonus",
				"extra_legendary_pool",
				"extra_pierce",
				"fragment_gain",
				"guaranteed_uncommon_shop_item",
				"hero_speed_penalty_while_firing",
				"hit_all_in_arc",
				"nova_pulse",
				"on_kill_explode",
				"orbit_blades",
				"pull_fragments",
				"proximity_aura_damage",
				"revive_once",
				"self_damage_in_radius",
				"shockwave_every_kills",
				"soul_gain",
				"start_gold",
				"weak_phylactery"
			]
		},
		"pattern": {
			"type": "object",
			"required": ["id"],
			"additionalProperties": false,
			"properties": {
				"id": {
					"$ref": "common.schema.json#/$defs/id"
				},
				"params": {
					"type": "object"
				}
			}
		}
	}
}
