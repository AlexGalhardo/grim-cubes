{
	"type": "array",
	"minItems": 1,
	"items": {
		"type": "object",
		"required": [
			"id",
			"name",
			"kind",
			"range",
			"attacksPerSecond",
			"damage",
			"knockback",
			"damageMult",
			"attackSpeedBonusPerTier",
			"rangeBonusPerTier"
		],
		"additionalProperties": false,
		"properties": {
			"id": {
				"$ref": "common.schema.json#/$defs/id"
			},
			"name": {
				"$ref": "common.schema.json#/$defs/name"
			},
			"kind": {
				"enum": ["melee", "single_shot", "burst", "continuous", "explosive", "boomerang"]
			},
			"range": {
				"type": "number",
				"minimum": 0
			},
			"attacksPerSecond": {
				"type": "number",
				"minimum": 0
			},
			"damage": {
				"type": "number",
				"minimum": 0
			},
			"knockback": {
				"type": "number",
				"minimum": 0
			},
			"arcDegrees": {
				"type": "number",
				"minimum": 0,
				"maximum": 360
			},
			"projectile": {
				"type": "object",
				"required": ["count"],
				"additionalProperties": false,
				"properties": {
					"count": {
						"type": "integer",
						"minimum": 1
					},
					"radius": {
						"type": "number",
						"minimum": 0
					},
					"speed": {
						"type": "number",
						"minimum": 0
					},
					"pierce": {
						"type": "integer",
						"minimum": 0
					},
					"spreadDegrees": {
						"type": "number",
						"minimum": 0
					},
					"explosionRadius": {
						"type": "number",
						"minimum": 0
					},
					"bounces": {
						"type": "array",
						"description": "Boomerang: targets hit per level of the weapon (the first hit included); one entry per damageMult entry.",
						"minItems": 1,
						"maxItems": 10,
						"items": { "type": "integer", "minimum": 1 }
					},
					"bounceRadius": {
						"type": "number",
						"minimum": 0,
						"description": "Boomerang: how far from the target it just hit the next one may be, in u."
					}
				}
			},
			"special": {
				"$ref": "common.schema.json#/$defs/effect"
			},
			"startingWeapon": {
				"type": "boolean"
			},
			"damageMult": {
				"type": "array",
				"minItems": 4,
				"maxItems": 10,
				"items": {
					"type": "number",
					"minimum": 0
				}
			},
			"attackSpeedBonusPerTier": {
				"type": "number",
				"minimum": 0
			},
			"rangeBonusPerTier": {
				"type": "number",
				"minimum": 0
			}
		}
	}
}
