{
	"type": "array",
	"minItems": 1,
	"items": {
		"type": "object",
		"required": ["id", "name", "tier", "modifiers", "effects", "price"],
		"additionalProperties": false,
		"properties": {
			"id": {
				"$ref": "common.schema.json#/$defs/id"
			},
			"name": {
				"$ref": "common.schema.json#/$defs/name"
			},
			"tier": {
				"$ref": "common.schema.json#/$defs/tier"
			},
			"price": {
				"type": "integer",
				"minimum": 1
			},
			"modifiers": {
				"$ref": "common.schema.json#/$defs/modifiers"
			},
			"exclusiveTo": {
				"$ref": "common.schema.json#/$defs/id",
				"description": "Ossuary node that adds this item to the pool (GDD 19.1); absent for items every run can find."
			},
			"status": {
				"enum": ["alpha"],
				"description": "Present while a special effect is not implemented yet (TODO:ALPHA); modifiers still apply."
			},
			"effects": {
				"$ref": "common.schema.json#/$defs/effects"
			}
		}
	}
}
