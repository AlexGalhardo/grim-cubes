{
	"type": "object",
	"required": [
		"chance",
		"pityRounds",
		"minRound",
		"excludeBossRounds",
		"scale",
		"entryDelaySeconds",
		"incomingWarningSeconds",
		"reward",
		"modifiers"
	],
	"additionalProperties": false,
	"properties": {
		"chance": {
			"type": "number",
			"minimum": 0,
			"maximum": 1
		},
		"pityRounds": {
			"type": "integer",
			"minimum": 1
		},
		"minRound": {
			"type": "integer",
			"minimum": 1
		},
		"excludeBossRounds": {
			"type": "boolean"
		},
		"scale": {
			"type": "number",
			"minimum": 1
		},
		"incomingWarningSeconds": {
			"type": "number",
			"minimum": 0,
			"description": "Lead time of the EliteIncoming event before the elite enters."
		},
		"entryDelaySeconds": {
			"type": "number",
			"minimum": 0
		},
		"reward": {
			"type": "object",
			"required": ["chest", "souls", "healHp"],
			"additionalProperties": false,
			"properties": {
				"chest": {
					"type": "object",
					"required": ["tier", "offered", "picks"],
					"additionalProperties": false,
					"properties": {
						"tier": {
							"$ref": "common.schema.json#/$defs/tier"
						},
						"offered": {
							"type": "integer",
							"minimum": 1
						},
						"picks": {
							"type": "integer",
							"minimum": 1
						}
					}
				},
				"souls": {
					"type": "integer",
					"minimum": 0
				},
				"healHp": {
					"type": "number",
					"minimum": 0
				}
			}
		},
		"modifiers": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["id", "name", "hpMult", "aura"],
				"additionalProperties": false,
				"properties": {
					"id": {
						"$ref": "common.schema.json#/$defs/id"
					},
					"name": {
						"$ref": "common.schema.json#/$defs/name"
					},
					"hpMult": {
						"type": "number",
						"minimum": 1
					},
					"aura": {
						"$ref": "common.schema.json#/$defs/id"
					},
					"armorAdd": {
						"type": "number"
					},
					"speedMult": {
						"type": "number",
						"minimum": 0
					},
					"lifestealOfDamage": {
						"type": "number",
						"minimum": 0,
						"maximum": 1
					},
					"onDeathExplosion": {
						"type": "object",
						"required": ["radius", "damageBase", "damagePerRound"],
						"additionalProperties": false,
						"properties": {
							"radius": {
								"type": "number",
								"minimum": 0
							},
							"damageBase": {
								"type": "number",
								"minimum": 0
							},
							"damagePerRound": {
								"type": "number",
								"minimum": 0
							}
						}
					}
				}
			}
		}
	}
}
