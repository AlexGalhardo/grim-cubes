{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "props.schema.json",
	"title": "World props (SDD 03 section 3, Art Bible 5.1)",
	"type": "array",
	"minItems": 1,
	"items": {
		"type": "object",
		"required": ["id", "sizeClass", "kind", "radius", "height"],
		"additionalProperties": false,
		"properties": {
			"id": {
				"$ref": "common.schema.json#/$defs/id"
			},
			"sizeClass": {
				"enum": ["small", "medium", "large"],
				"description": "Sets the model element budget (4 / 8 / 16)."
			},
			"kind": {
				"enum": ["blocking", "decor", "breakable"]
			},
			"radius": {
				"type": "number",
				"minimum": 0,
				"description": "Collision circle radius in units; only blocking props collide."
			},
			"height": {
				"type": "number",
				"exclusiveMinimum": 0,
				"description": "Model height in units; props taller than render.json propFade.minHeight fade when they hide the hero."
			}
		}
	}
}
