{
	"type": "object",
	"required": ["doubleCard", "cards"],
	"additionalProperties": false,
	"properties": {
		"doubleCard": {
			"type": "object",
			"required": ["minLevel", "chance", "bonuses"],
			"additionalProperties": false,
			"properties": {
				"minLevel": {
					"type": "integer",
					"minimum": 1
				},
				"chance": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"bonuses": {
					"type": "integer",
					"minimum": 2
				}
			}
		},
		"cards": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["id", "name", "modifiers"],
				"additionalProperties": false,
				"properties": {
					"id": {
						"$ref": "common.schema.json#/$defs/id"
					},
					"name": {
						"$ref": "common.schema.json#/$defs/name"
					},
					"modifiers": {
						"$ref": "common.schema.json#/$defs/modifiers"
					}
				}
			}
		}
	}
}
