{
	"$defs": {
		"range": {
			"type": "array",
			"minItems": 2,
			"maxItems": 2,
			"items": { "type": "integer", "minimum": 0 }
		}
	},
	"type": "array",
	"minItems": 1,
	"items": {
		"type": "object",
		"required": ["id", "name", "ring", "enemyPool"],
		"additionalProperties": false,
		"properties": {
			"id": {
				"$ref": "common.schema.json#/$defs/id"
			},
			"name": {
				"$ref": "common.schema.json#/$defs/name"
			},
			"ring": {
				"type": "integer",
				"minimum": 0
			},
			"weather": {
				"enum": ["fog", "rain", "embers", "wind", "ice"],
				"description": "Ambient VFX of the biome (S-24-02)."
			},
			"floorTiles": {
				"type": "array",
				"items": {
					"type": "string"
				}
			},
			"props": {
				"type": "object",
				"required": ["blocking", "decor", "breakable"],
				"additionalProperties": false,
				"properties": {
					"blocking": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"decor": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"breakable": {
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				}
			},
			"propCounts": {
				"type": "object",
				"required": ["blocking", "decor", "breakable"],
				"additionalProperties": false,
				"properties": {
					"blocking": { "$ref": "#/$defs/range" },
					"decor": { "$ref": "#/$defs/range" },
					"breakable": { "$ref": "#/$defs/range" }
				}
			},
			"propDensity": {
				"type": "number",
				"minimum": 0,
				"maximum": 1
			},
			"enemyPool": {
				"type": "array",
				"minItems": 1,
				"items": {
					"$ref": "common.schema.json#/$defs/id"
				}
			},
			"music": {
				"type": "string"
			},
			"fogColor": {
				"type": "string",
				"pattern": "^#[0-9A-Fa-f]{6}$"
			}
		}
	}
}
