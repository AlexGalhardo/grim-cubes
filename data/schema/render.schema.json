{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "render.schema.json",
	"title": "Render constants (GDD section 5, ADR-0017)",
	"type": "object",
	"additionalProperties": false,
	"required": ["camera", "propFade", "vfx"],
	"properties": {
		"camera": {
			"type": "object",
			"additionalProperties": false,
			"required": ["alpha", "elevationDegrees", "fov", "radius", "radiusMobile", "followRate"],
			"properties": {
				"alpha": {
					"type": "number",
					"description": "Horizontal angle in radians (-pi/2 puts north at the top of the screen)."
				},
				"elevationDegrees": {
					"type": "number",
					"minimum": 50,
					"maximum": 60,
					"description": "Elevation above the ground; Babylon beta is pi/2 minus this."
				},
				"fov": {
					"type": "number",
					"minimum": 0.43,
					"maximum": 0.61,
					"description": "Vertical field of view in radians (25 to 35 degrees)."
				},
				"radius": {
					"type": "number",
					"minimum": 32,
					"maximum": 44
				},
				"radiusMobile": {
					"type": "number",
					"minimum": 28,
					"maximum": 44
				},
				"followRate": {
					"type": "number",
					"exclusiveMinimum": 0,
					"description": "Exponential follow rate per second of the camera target (lerp 8/s)."
				}
			}
		},
		"propFade": {
			"type": "object",
			"additionalProperties": false,
			"required": ["minHeight", "alpha", "ratePerSecond", "heroHalfWidth", "heroHeight"],
			"properties": {
				"minHeight": {
					"type": "number",
					"minimum": 0,
					"description": "Props taller than this (units) may fade."
				},
				"alpha": {
					"type": "number",
					"minimum": 0,
					"maximum": 1,
					"description": "Opacity of a prop that hides the hero."
				},
				"ratePerSecond": {
					"type": "number",
					"exclusiveMinimum": 0,
					"description": "Exponential fade rate per second."
				},
				"heroHalfWidth": {
					"type": "number",
					"minimum": 0,
					"description": "Lateral clearance, in units, added to a prop's radius when testing the line of sight."
				},
				"heroHeight": {
					"type": "number",
					"exclusiveMinimum": 0,
					"description": "Height of the hero's centre the camera looks at, in units."
				}
			}
		},
		"vfx": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"particlePool",
				"decalPool",
				"damageNumberPool",
				"bloodCubesPerHit",
				"bloodCubesPerDeath",
				"explosionCubes",
				"reducedDeathCubes",
				"cubeSizeRange",
				"particleLifeSeconds",
				"gravity",
				"bloodLightShare",
				"decalSizeRange",
				"decalFromLandingChance",
				"hitStopCritMs",
				"hitStopBossDeathMs",
				"flashBrightness",
				"flashSeconds",
				"damageNumberLifeSeconds",
				"damageNumberRise",
				"damageNumberHeight",
				"projectileSize"
			],
			"properties": {
				"particlePool": {
					"type": "integer",
					"minimum": 1,
					"description": "Fixed cube particle pool (Art Bible 5.4: 600 desktop)."
				},
				"decalPool": {
					"type": "integer",
					"minimum": 0,
					"description": "Blood decal pool, FIFO (200 desktop)."
				},
				"damageNumberPool": { "type": "integer", "minimum": 1 },
				"bloodCubesPerHit": {
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": { "type": "integer", "minimum": 0 }
				},
				"bloodCubesPerDeath": {
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": { "type": "integer", "minimum": 0 }
				},
				"explosionCubes": {
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": { "type": "integer", "minimum": 0 }
				},
				"reducedDeathCubes": {
					"type": "integer",
					"minimum": 0,
					"description": "Grey cubes of a death with reduced gore."
				},
				"cubeSizeRange": {
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": { "type": "number", "exclusiveMinimum": 0 }
				},
				"particleLifeSeconds": { "type": "number", "exclusiveMinimum": 0 },
				"gravity": { "type": "number", "minimum": 0 },
				"bloodLightShare": { "type": "number", "minimum": 0, "maximum": 1 },
				"decalSizeRange": {
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": { "type": "number", "exclusiveMinimum": 0 }
				},
				"decalFromLandingChance": { "type": "number", "minimum": 0, "maximum": 1 },
				"hitStopCritMs": { "type": "number", "minimum": 0 },
				"hitStopBossDeathMs": { "type": "number", "minimum": 0 },
				"flashBrightness": {
					"type": "number",
					"minimum": 1,
					"description": "Instance colour multiplier of a hit enemy; above 1 it burns towards white."
				},
				"flashSeconds": { "type": "number", "exclusiveMinimum": 0 },
				"damageNumberLifeSeconds": { "type": "number", "exclusiveMinimum": 0 },
				"damageNumberRise": { "type": "number", "minimum": 0 },
				"damageNumberHeight": { "type": "number", "exclusiveMinimum": 0 },
				"projectileSize": { "type": "number", "exclusiveMinimum": 0 }
			}
		}
	}
}
